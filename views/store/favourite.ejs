<%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-[#F4F2EC] text-[#1E2A26] antialiased selection:bg-[#2F5D50] selection:text-white" style="font-family: 'Inter', sans-serif;">
<%- include('../partials/nav') %>
  
  <main class="flex min-h-[calc(100vh-4rem)] items-center justify-center p-4 sm:p-6 lg:p-8">
    <!-- Main Dashboard Container -->
    <div class="flex w-full max-w-6xl flex-col overflow-hidden rounded-[2.5rem] bg-white shadow-2xl shadow-[#2F5D50]/10 ring-1 ring-black/5 md:h-[85vh] md:min-h-[700px] md:flex-row">

      <!-- Left Sidebar (Branding & Context) -->
      <section class="relative hidden w-full flex-col justify-between overflow-hidden bg-[#2F5D50] p-10 text-white md:flex md:w-2/5 lg:w-[35%] lg:p-12">
        <!-- Decorative Background Elements -->
        <div class="absolute -left-20 -top-20 h-64 w-64 rounded-full bg-white/5 blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 h-80 w-80 rounded-full bg-black/20 blur-3xl"></div>
        
        <div class="relative z-10 space-y-8">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-[10px] font-bold uppercase tracking-[0.25em] text-white backdrop-blur-md">
            <span class="h-1.5 w-1.5 rounded-full bg-[#EAF6F0] animate-pulse"></span>
            Stayspot Workspace
          </span>
          
          <div class="space-y-4">
            <h2 class="text-4xl font-bold tracking-tight text-white sm:text-[2.75rem] sm:leading-[1.1]">
              Your curated collection.
            </h2>
            <p class="max-w-[28ch] text-base leading-relaxed text-[#D5EFE3]">
              Browse your favourite listings in a clean, modern layout designed for focus and inspiration.
            </p>
          </div>
        </div>

        <div class="relative z-10 rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm">
          <p class="text-sm font-medium leading-relaxed text-[#D5EFE3]">
            "Manage your dream destinations effortlessly from this distraction-free dashboard."
          </p>
        </div>
      </section>

      <!-- Right Content Area (Scrollable Favourites) -->
      <section class="relative flex w-full flex-col bg-[#FDFCF8] md:w-3/5 lg:w-[65%]">
        
        <!-- Sticky Header -->
        <header class="sticky top-0 z-20 border-b border-[#E6E2DA]/60 bg-[#FDFCF8]/80 px-8 py-8 backdrop-blur-xl sm:px-10">
          <p class="text-xs font-bold uppercase tracking-[0.25em] text-[#8C877A]">Favourites</p>
          <div class="mt-2 flex items-center justify-between">
            <h1 class="text-3xl font-bold tracking-tight text-[#1E2A26]">Saved Homes</h1>
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#EAF6F0] text-sm font-bold text-[#2F5D50]">
              <%= favouriteHomes ? favouriteHomes.length : 0 %>
            </span>
          </div>
        </header>

        <!-- Scrollable List -->
        <div class="flex-1 overflow-y-auto p-8 sm:px-10 pb-20">
          <% if (favouriteHomes && favouriteHomes.length > 0) { %>
            <div class="space-y-8">
              <% favouriteHomes.forEach(home => { %>
                <!-- Property Card -->
                <article class="group relative overflow-hidden rounded-[2rem] border border-[#E6E2DA] bg-white p-2 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-[#2F5D50]/30 hover:shadow-xl hover:shadow-[#2F5D50]/5">
                  <div class="p-5 sm:p-6">
                    
                    <!-- Card Header -->
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                      <div>
                        <h2 class="text-2xl font-bold tracking-tight text-[#1E2A26] transition-colors group-hover:text-[#2F5D50]">
                          <%= home.housename || 'Untitled Property' %>
                        </h2>
                        <div class="mt-2 flex items-center gap-1.5 text-sm font-medium text-[#6B6558]">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#8C877A]" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                          </svg>
                          <%= home.location || 'Location not provided' %>
                        </div>
                      </div>
                      
                      <div class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-gradient-to-r from-[#EAF6F0] to-[#D5EFE3] px-4 py-2 shadow-inner ring-1 ring-[#2F5D50]/10">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#2F5D50]" viewBox="0 0 20 20" fill="currentColor">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                        <span class="text-sm font-bold text-[#2F5D50]"><%= home.rating || 'N/A' %><span class="text-[#2F5D50]/60">/5</span></span>
                      </div>
                    </div>

                    <!-- Details Grid -->
                    <div class="mt-6 grid gap-4 lg:grid-cols-[1fr_2.5fr]">
                      <div class="flex flex-col justify-center rounded-[1.25rem] bg-[#F4F2EC]/50 p-5 ring-1 ring-inset ring-[#E6E2DA]/50">
                        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#8C877A]">Price</p>
                        <p class="mt-2 text-2xl font-bold text-[#1E2A26]"><%= home.price ? `Rs. ${home.price}` : 'N/A' %></p>
                      </div>
                      
                      <div class="rounded-[1.25rem] bg-[#F4F2EC]/50 p-5 ring-1 ring-inset ring-[#E6E2DA]/50">
                        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#8C877A]">Description</p>
                        <p class="mt-2 text-sm leading-relaxed text-[#4A463C] line-clamp-2">
                          <%= home.description || 'No description provided.' %>
                        </p>
                      </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="mt-6 flex flex-wrap items-center gap-3">
                      <a href="/home-detail/<%= home._id %>" class="flex-1 inline-flex h-12 items-center justify-center rounded-xl bg-[#2F5D50] px-6 text-sm font-bold text-white shadow-md shadow-[#2F5D50]/20 transition-all hover:-translate-y-0.5 hover:bg-[#234438] hover:shadow-lg focus:ring-4 focus:ring-[#2F5D50]/30 active:translate-y-0">
                        Reserve Now
                      </a>
                      
                      <a href="/home-detail/<%= home._id %>" class="flex-1 inline-flex h-12 items-center justify-center rounded-xl border-2 border-[#EAF6F0] bg-white px-6 text-sm font-bold text-[#2F5D50] transition-all hover:bg-[#EAF6F0] focus:ring-4 focus:ring-[#2F5D50]/10">
                        View Details
                      </a>
                      
                      <form action="/favourite/delete/<%= home._id %>" method="post" class="flex sm:w-auto w-full">
                        <button type="submit" class="group/btn w-full inline-flex h-12 items-center justify-center gap-2 rounded-xl bg-[#FFF5F5] px-5 text-sm font-bold text-[#E53E3E] transition-all hover:bg-[#E53E3E] hover:text-white focus:ring-4 focus:ring-red-100">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover/btn:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                          <span class="sm:hidden lg:inline">Remove</span>
                        </button>
                      </form>
                    </div>

                  </div>
                </article>
              <% }) %>
            </div>
          <% } else { %>
            <!-- Empty State -->
            <div class="flex flex-col items-center justify-center rounded-[2rem] border-2 border-dashed border-[#E6E2DA] bg-[#FDFCF8] px-6 py-20 text-center transition-colors hover:border-[#2F5D50]/30">
              <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-[#EAF6F0]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[#2F5D50]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-[#1E2A26]">No Favourites Yet</h2>
              <p class="mt-3 max-w-md text-sm leading-relaxed text-[#6B6558]">
                Your curated workspace is waiting. Explore our collection of premium properties and tap the heart icon to save them here.
              </p>
              <a href="/" class="mt-8 inline-flex h-12 items-center justify-center rounded-xl bg-[#2F5D50] px-8 text-sm font-bold text-white shadow-md transition-all hover:-translate-y-1 hover:bg-[#234438] hover:shadow-lg focus:ring-4 focus:ring-[#2F5D50]/30">
                Browse Collection
              </a>
            </div>
          <% } %>
        </div>
      </section>
      
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>