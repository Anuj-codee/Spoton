<%- include('../partials/head') %>

</head>
<body class="min-h-screen bg-slate-950 text-slate-100" style="font-family: 'Inter', sans-serif;">

  <nav class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3 min-w-fit">
        <div class="w-10 h-10 rounded-xl bg-linear-to-br from-amber-500 to-yellow-400 flex items-center justify-center text-white font-bold text-lg shadow-lg shadow-amber-900/40">
          S
        </div>
        <div>
          <span class="text-lg font-bold text-white tracking-tight block">My Favourites</span>
          <span class="text-xs text-slate-400">Saved Homes</span>
        </div>
      </div>

      <div class="flex items-center gap-2 flex-wrap justify-center">
        <a href="/" class="group relative flex items-center gap-2 text-slate-300 hover:text-white font-medium px-4 py-2.5 rounded-lg transition-all duration-200 hover:bg-slate-800/50">
          <span class="text-sm">Browse</span>
        </a>
        <a href="/host/host-home-list" class="group relative flex items-center gap-2 text-slate-300 hover:text-white font-medium px-4 py-2.5 rounded-lg transition-all duration-200 hover:bg-slate-800/50">
          <span class="text-sm">My Homes</span>
        </a>
        <a href="/host/bookings" class="group relative flex items-center gap-2 text-slate-300 hover:text-white font-medium px-4 py-2.5 rounded-lg transition-all duration-200 hover:bg-slate-800/50">
          <span class="text-sm">Bookings</span>
        </a>
      </div>

      <a href="/host/add-home" class="group relative flex items-center gap-2 bg-linear-to-r from-rose-500 via-orange-400 to-red-500 hover:from-rose-600 hover:via-orange-500 hover:to-red-600 text-white font-semibold px-6 py-2.5 rounded-xl transition-all duration-300 shadow-xl shadow-rose-900/60 hover:-translate-y-1 ml-2 whitespace-nowrap">
        <span class="text-sm font-bold relative z-10">Add Home</span>
      </a>
    </div>
  </nav>

  <div class="max-w-6xl mx-auto px-6 py-12">
    <% if (favouriteHomes && favouriteHomes.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% favouriteHomes.forEach(home => { %>
          <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden hover:border-amber-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-amber-900/20 group">
            <% if (home.photoUrl) { %>
              <img src="<%= home.photoUrl %>" alt="<%= home.housename || 'Home photo' %>" class="w-full h-48 object-cover">
            <% } else { %>
              <div class="w-full h-48 bg-slate-800 flex items-center justify-center text-slate-500 text-sm">No photo</div>
            <% } %>

            <div class="p-6 space-y-4">
              <div>
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-xl font-bold text-white mb-1"><%= home.housename || 'Untitled Property' %></h3>
                  <span class="text-sm font-semibold text-amber-300"><%= home.rating || 'N/A' %>/5</span>
                </div>
                <p class="text-sm text-slate-400"><%= home.location || 'Location not provided' %></p>
              </div>

              <p class="text-slate-300 text-sm"><%= home.description || 'No description provided.' %></p>

              <div class="flex items-center justify-between pt-4 border-t border-slate-800">
                <span class="text-slate-400 text-sm">Price</span>
                <span class="text-lg font-bold text-amber-400"><%= home.price ? `Rs. ${home.price}` : 'N/A' %></span>
              </div>
            </div>

            <div class="px-6 pb-6 pt-4 border-t border-slate-800 flex gap-3">
              <a href="/home-detail/<%= home._id %>" class="flex-1 inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold px-4 py-2.5 rounded-lg transition-all duration-200 text-sm">
                View Details
              </a>
              <a href="/home-detail/<%= home._id %>" class="flex-1 inline-flex items-center justify-center gap-2 bg-linear-to-r from-rose-500 to-orange-400 hover:from-rose-600 hover:to-orange-500 text-white font-semibold px-4 py-2.5 rounded-lg transition-all duration-200 text-sm shadow-lg shadow-rose-900/30 hover:-translate-y-0.5">
                Reserve
              </a>
              <form action="/favourite/delete/<%=home._id%>" method="post">
                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white font-semibold px-4 py-2.5 rounded-lg transition-colors text-sm">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center max-w-sm mx-auto py-20">
        <h1 class="text-3xl font-extrabold text-white tracking-tight mb-2">No Favourite Homes Yet</h1>
        <p class="text-slate-400 text-base mb-8">Start adding homes to your favourites to see them here!</p>
        <a href="/" class="inline-flex items-center gap-2 bg-linear-to-r from-rose-500 to-orange-400 hover:from-rose-600 hover:to-orange-500 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200 shadow-lg shadow-rose-900/40 hover:-translate-y-0.5">
          Browse Homes
        </a>
      </div>
    <% } %>
  </div>

  <footer class="mt-16 border-t border-slate-800 py-8 text-center text-slate-700 text-xs">
    2026 StaySpot. All rights reserved.
  </footer>

</body>
</html>
