<%- include('../partials/head') %>
<%- include('../partials/nav') %>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 px-6 py-10" style="font-family: 'Inter', sans-serif;">
  <main class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-4xl font-extrabold text-white tracking-tight">My Bookings</h1>
        <p class="text-slate-400 mt-2">Review booked homes with their location, rating, and stay details.</p>
      </div>
      <a href="/" class="bg-slate-800 hover:bg-slate-700 text-white font-semibold px-5 py-3 rounded-xl transition-colors">Browse Homes</a>
    </div>

    <% if (registeredHomes && registeredHomes.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% registeredHomes.forEach(home => { %>
          <article class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl shadow-black/20 flex flex-col sm:flex-row">
            <% if (home.photoUrl) { %>
              <img src="<%= home.photoUrl %>" alt="<%= home.housename || 'Home photo' %>" class="w-full sm:w-56 h-48 sm:h-auto object-cover">
            <% } else { %>
              <div class="w-full sm:w-56 h-48 sm:h-auto bg-slate-800 flex items-center justify-center text-slate-500 text-sm">No photo</div>
            <% } %>
            <div class="p-6 flex-1">
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-xl font-bold text-white"><%= home.housename || 'Untitled Property' %></h2>
                <span class="text-sm font-semibold text-amber-300"><%= home.rating || 'N/A' %>/5</span>
              </div>
              <p class="text-slate-400 text-sm mt-1"><%= home.location || 'Location not provided' %></p>
              <p class="text-slate-300 text-sm mt-4"><%= home.description || 'No description provided.' %></p>
              <div class="flex items-center justify-between mt-5 pt-5 border-t border-slate-800">
                <span class="text-rose-400 font-bold"><%= home.price ? `Rs. ${home.price}` : 'Price not provided' %></span>
                <a href="/home-detail/<%= home._id %>" class="text-sm font-semibold text-white bg-slate-800 hover:bg-slate-700 px-4 py-2 rounded-lg transition-colors">Details</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-20">
        <h2 class="text-2xl font-bold text-white mb-2">No bookings yet</h2>
        <p class="text-slate-400">Homes you book will appear here.</p>
      </div>
    <% } %>
  </main>
</body>
</html>
