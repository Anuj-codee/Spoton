<%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-[#F6F4EE] text-[#1E2A26]" style="font-family: 'Inter', sans-serif;">
<%- include('../partials/nav') %>

  <main class="min-h-screen px-4 py-6 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl overflow-hidden rounded-[2rem] border border-[#DCD6C6] bg-white shadow-[0_20px_70px_rgba(30,42,38,0.12)]">
      <div class="grid lg:grid-cols-[0.95fr_1.05fr]">

        <section class="relative overflow-hidden bg-[radial-gradient(120%_120%_at_15%_10%,_#3C7361_0%,_#2F5D50_45%,_#234438_100%)] p-8 text-white sm:p-10 lg:p-12">
          <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(rgba(255,255,255,0.18) 1px, transparent 1px); background-size: 14px 14px;"></div>
          <div class="relative flex h-full flex-col justify-between gap-8">
            <div>
              <span class="mb-6 inline-block rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] text-white/80">StaySpot</span>
              <h1 class="font-['Fraunces'] text-3xl leading-tight sm:text-4xl">
                <%= home.housename || 'Untitled Property' %>
              </h1>
              <p class="mt-4 max-w-[30ch] text-sm leading-7 text-white/80 sm:text-base">
                <%= home.location || 'Location not provided' %>
              </p>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              <div class="rounded-2xl border border-white/20 bg-white/10 p-4 backdrop-blur-sm">
                <p class="text-2xl font-semibold"><%= home.price ? `Rs. ${home.price}` : 'N/A' %></p>
                <p class="text-sm text-white/70">Price</p>
              </div>
              <div class="rounded-2xl border border-white/20 bg-white/10 p-4 backdrop-blur-sm">
                <p class="text-2xl font-semibold"><%= home.rating || 'N/A' %>/5</p>
                <p class="text-sm text-white/70">Guest rating</p>
              </div>
            </div>
          </div>
        </section>

        <section class="bg-[#FCFBF7] p-6 sm:p-8 lg:p-10">
          <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <span class="mb-3 inline-block rounded-full border border-[#DCD6C6] bg-[#F6F4EE] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] text-[#2F5D50]">Property details</span>
              <h2 class="text-2xl font-semibold text-[#1E2A26] sm:text-3xl">
                <%= home.housename || 'Untitled Property' %>
              </h2>
              <p class="mt-2 text-sm text-[#6B6558] sm:text-base">
                <%= home.location || 'Location not provided' %>
              </p>
            </div>
            <a href="/host/add-home" class="inline-flex items-center justify-center rounded-xl bg-[#2F5D50] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#234438]">
              Add a home
            </a>
          </div>

          <% if (home.photo || home.photo) { %>
            <div class="overflow-hidden rounded-[1.5rem] border border-[#DCD6C6] bg-white shadow-sm">
              <img src="<%= home.photo || home.photo || '' %>" alt="<%= home.housename || 'Home photo' %>" class="h-72 w-full object-cover">
            </div>
          <% } else { %>
            <div class="flex h-72 w-full items-center justify-center rounded-[1.5rem] border border-dashed border-[#DCD6C6] bg-[#F6F4EE] text-sm text-[#6B6558]">
              No photo
            </div>
          <% } %>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="rounded-[1.25rem] border border-[#DCD6C6] bg-[#F6F4EE] p-4">
              <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.24em] text-[#9C978A]">Price</span>
              <span class="text-2xl font-semibold text-[#1E2A26]"><%= home.price ? `Rs. ${home.price}` : 'Not provided' %></span>
            </div>

            <div class="rounded-[1.25rem] border border-[#DCD6C6] bg-[#F6F4EE] p-4">
              <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.24em] text-[#9C978A]">Rating</span>
              <span class="text-2xl font-semibold text-[#2F5D50]"><%= home.rating || 'N/A' %>/5</span>
            </div>

            <div class="rounded-[1.25rem] border border-[#DCD6C6] bg-[#F6F4EE] p-4">
              <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.24em] text-[#9C978A]">Location</span>
              <span class="text-sm font-semibold text-[#1E2A26]"><%= home.location || 'Not provided' %></span>
            </div>

            <div class="rounded-[1.25rem] border border-[#DCD6C6] bg-[#F6F4EE] p-4">
              <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.24em] text-[#9C978A]">Home ID</span>
              <span class="text-sm font-mono text-[#4A463C]"><%= home._id %></span>
            </div>
          </div>

          <div class="mt-6 rounded-[1.5rem] border border-[#DCD6C6] bg-white p-5">
            <h2 class="text-xl font-semibold text-[#1E2A26] mb-4">Description</h2>
            <p class="text-sm leading-7 text-[#4A463C]"><%= home.description || 'No description provided.' %></p>
          </div>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="/" class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl border border-[#DCD6C6] bg-white px-6 py-3 text-sm font-semibold text-[#1E2A26] transition hover:bg-[#F6F4EE]">
              Back to Homes
            </a>
            <button class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl bg-[#2F5D50] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#234438]">
              Reserve Now
            </button>
            <div class="flex-1">
              <%- include('../partials/favouriteDetail',{home:home}) %>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

<%- include('../partials/footer') %>
</body>
</html>
