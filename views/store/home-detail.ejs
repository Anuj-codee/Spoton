<%- include('../partials/head') %>
  <style>
    .detail-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }
    .detail-item {
      background-color: rgba(30, 41, 59, 0.5);
      border: 1px solid rgba(71, 85, 105, 0.3);
      border-radius: 0.75rem;
      padding: 1.25rem;
    }
  </style>
</head>

<body class="min-h-screen bg-slate-950 text-slate-100" style="font-family: 'Inter', sans-serif;">

  <nav class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3 min-w-fit">
        <div class="w-10 h-10 rounded-xl bg-linear-to-br from-rose-500 to-orange-400 flex items-center justify-center text-white font-bold text-lg shadow-lg shadow-rose-900/40">
          S
        </div>
        <div>
          <span class="text-lg font-bold text-white tracking-tight block">StaySpot</span>
          <span class="text-xs text-slate-400">Details</span>
        </div>
      </div>

      <div class="flex items-center gap-2 flex-wrap justify-center">
        <a href="/" class="group relative flex items-center gap-2 text-slate-300 hover:text-white font-medium px-4 py-2.5 rounded-lg transition-all duration-200 hover:bg-slate-800/50">
          <span class="text-sm">Browse</span>
        </a>
        <a href="/favourite" class="group relative flex items-center gap-2 text-slate-300 hover:text-amber-400 font-medium px-4 py-2.5 rounded-lg transition-all duration-200 hover:bg-amber-500/10">
          <span class="text-sm">Favourites</span>
        </a>
        <a href="/host/host-home-list" class="group relative flex items-center gap-2 text-slate-300 hover:text-white font-medium px-4 py-2.5 rounded-lg transition-all duration-200 hover:bg-slate-800/50">
          <span class="text-sm">My Homes</span>
        </a>
        <a href="/host/bookings" class="group relative flex items-center gap-2 text-slate-300 hover:text-white font-medium px-4 py-2.5 rounded-lg transition-all duration-200 hover:bg-slate-800/50">
          <span class="text-sm">Bookings</span>
        </a>
      </div>

      <a href="/host/add-home" class="group relative flex items-center gap-2 bg-linear-to-r from-rose-500 via-orange-400 to-red-500 hover:from-rose-600 hover:via-orange-500 hover:to-red-600 text-white font-semibold px-6 py-2.5 rounded-xl transition-all duration-300 shadow-xl shadow-rose-900/60 hover:-translate-y-1 ml-2 whitespace-nowrap">
        <span class="text-sm font-bold relative z-10">Add Home</span>
      </a>
    </div>
  </nav>

  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-xl shadow-black/20">
      <% if (home.photoUrl) { %>
        <img src="<%= home.photoUrl %>" alt="<%= home.housename || 'Home photo' %>" class="w-full h-80 object-cover rounded-xl mb-8">
      <% } %>

      <div class="mb-8">
        <h1 class="text-4xl font-extrabold text-white mb-2"><%= home.housename || 'Untitled Property' %></h1>
        <p class="text-slate-400"><%= home.location || 'Location not provided' %></p>
      </div>

      <div class="detail-grid mb-8">
        <div class="detail-item">
          <span class="text-xs font-medium uppercase tracking-wider text-slate-500 block mb-2">Price</span>
          <span class="text-2xl font-bold text-rose-400"><%= home.price ? `Rs. ${home.price}` : 'Not provided' %></span>
        </div>

        <div class="detail-item">
          <span class="text-xs font-medium uppercase tracking-wider text-slate-500 block mb-2">Rating</span>
          <span class="text-2xl font-bold text-amber-300"><%= home.rating || 'N/A' %>/5</span>
        </div>

        <div class="detail-item">
          <span class="text-xs font-medium uppercase tracking-wider text-slate-500 block mb-2">Location</span>
          <span class="text-lg font-semibold text-slate-100"><%= home.location || 'Not provided' %></span>
        </div>

        <div class="detail-item">
          <span class="text-xs font-medium uppercase tracking-wider text-slate-500 block mb-2">Home ID</span>
          <span class="text-sm font-mono text-slate-300"><%= home._id %></span>
        </div>
      </div>

      <div class="border-t border-slate-800 pt-8">
        <h2 class="text-xl font-semibold text-white mb-4">Description</h2>
        <p class="text-slate-300 leading-7"><%= home.description || 'No description provided.' %></p>
      </div>

      <div class="mt-8 pt-8 border-t border-slate-800 flex gap-4">
        <a href="/" class="flex-1 inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200">
          Back to Homes
        </a>
        <button class="flex-1 inline-flex items-center justify-center gap-2 bg-linear-to-r from-rose-500 to-orange-400 hover:from-rose-600 hover:to-orange-500 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200 shadow-lg shadow-rose-900/40 hover:-translate-y-0.5">
          Reserve Now
        </button>
        <%- include('../partials/favouriteDetail',{home:home}) %>
      </div>
    </div>
  </div>

  <footer class="mt-16 border-t border-slate-800 py-8 text-center text-slate-700 text-xs">
    2026 StaySpot. All rights reserved.
  </footer>

</body>
</html>
