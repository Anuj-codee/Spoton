<%- include('../partials/head') %>
<%- include('../partials/nav') %>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 flex flex-col items-center justify-center px-6" style="font-family: 'Inter', sans-serif;">

  <div class="text-center max-w-sm w-full">

    <!-- Success icon -->
    <div class="relative mx-auto mb-6 w-24 h-24">
      <div class="absolute inset-0 rounded-full bg-emerald-500/20 animate-ping"></div>
      <div class="relative w-24 h-24 rounded-full bg-linear-to-br from-emerald-500 to-teal-400 flex items-center justify-center shadow-lg shadow-emerald-900/40">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
    </div>

    <h1 class="text-3xl font-extrabold text-white tracking-tight mb-2">Home Registered!</h1>
    <p class="text-slate-400 mb-8">Your property has been successfully listed on StaySpot. Guests can now discover your home.</p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/"
         class="inline-flex items-center justify-center gap-2 bg-linear-to-r from-rose-500 to-orange-400 hover:from-rose-600 hover:to-orange-500 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200 shadow-lg shadow-rose-900/40 hover:-translate-y-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        View All Homes
      </a>
      <a href="/host/add-home"
         class="inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-semibold px-6 py-3 rounded-xl transition-all duration-200 hover:-translate-y-0.5">
        + Add Another
      </a>
    </div>

  </div>

  <!-- Footer -->
  <footer class="absolute bottom-6 text-slate-700 text-xs">
    © 2026 StaySpot. All rights reserved.
  </footer>

</body>
</html>