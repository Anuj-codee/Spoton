<%- include('../partials/head') %>
<body class="min-h-screen bg-[#F6F4EE] text-[#1E2A26] font-sans">
  <%- include('../partials/nav') %>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <section class="mb-8">
      <div class="flex items-end justify-between gap-6">
        <div>
          <h1 class="font-display text-4xl sm:text-5xl leading-none tracking-tight text-[#1E2A26] mb-2">My Homes</h1>
          <p class="text-sm text-[#7A7466]">Manage the places you've listed.</p>
        </div>
        <a href="/host/add-home" class="hidden sm:inline-flex items-center gap-2 rounded-xl bg-[#2F5D50] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#234438]">
          + Add Home
        </a>
      </div>
    </section>

    <% if (registeredHomes && registeredHomes.length > 0) { %>
      <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        <% registeredHomes.forEach(home => { %>
          <article class="group overflow-hidden rounded-[28px] border border-[#DCD6C6] bg-white shadow-[0_10px_35px_rgba(30,42,38,0.06)] transition-all duration-250 hover:-translate-y-1 hover:shadow-[0_24px_80px_rgba(47,93,80,0.14)]">
            <div class="relative">
              <% if (home.photoUrl) { %>
                <img src="<%= home.photoUrl %>" alt="<%= home.housename %>" class="w-full h-48 object-cover">
              <% } else { %>
                <div class="w-full h-48 bg-[#EFEBE0] flex items-center justify-center text-sm font-medium text-[#7A7466]">No photo</div>
              <% } %>
              <span class="absolute right-4 top-4 rounded-full bg-white/95 px-3 py-1 text-xs font-bold text-[#2F5D50] shadow-sm">
                <%= home.rating || 'N/A' %>/5
              </span>
            </div>

            <div class="p-6">
              <div class="flex items-start justify-between gap-4 mb-3">
                <div>
                  <h2 class="font-display text-2xl leading-none text-[#1E2A26] mb-2"><%= home.housename %></h2>
                  <p class="text-sm font-medium text-[#7A7466]"><%= home.location || 'Location not provided' %></p>
                </div>
              </div>

              <div class="mb-4">
                <p class="text-lg font-bold text-[#1E2A26]">Rs. <%= home.price %> <span class="text-sm font-medium text-[#7A7466]">per night</span></p>
              </div>

              <p class="text-sm leading-6 text-[#7A7466] mb-5"><%= home.description || 'No description provided.' %></p>

              <div class="flex flex-wrap items-center gap-2">
                <a href="/host/bookings" class="inline-flex items-center justify-center rounded-lg bg-[#2F5D50] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#234438]">
                  View bookings
                </a>
                <a href="/host/edit-home/<%= home._id %>?editing=true" class="inline-flex items-center justify-center rounded-lg border border-[#DCD6C6] bg-[#F6F4EE] px-4 py-2 text-sm font-semibold text-[#1E2A26] transition hover:bg-[#DCD6C6]">
                  Edit
                </a>
                <form action="/host/host-home-delete/<%= home._id %>" method="post" class="ml-auto">
                  <button type="submit" class="inline-flex items-center justify-center rounded-lg border border-[#C1622D] px-4 py-2 text-sm font-semibold text-[#C1622D] transition hover:bg-[#C1622D] hover:text-white">
                    Delete
                  </button>
                </form>
              </div>
            </div>
          </article>
        <% }); %>
      </section>
    <% } else { %>
      <section class="rounded-[28px] border border-dashed border-[#DCD6C6] bg-white py-14 text-center shadow-sm">
        <p class="font-display text-2xl text-[#1E2A26] mb-2">No homes registered yet</p>
        <p class="text-sm text-[#7A7466] mb-6">List your first place to start welcoming guests.</p>
        <a href="/host/add-home" class="inline-flex items-center gap-2 rounded-xl bg-[#2F5D50] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#234438]">
          + Add your first home
        </a>
      </section>
    <% } %>

    <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-[#7A7466] hover:text-[#1E2A26] mt-10 transition-colors">
      ← Back to home
    </a>
  </main>
 <%- include('../partials/footer') %>
</body>
</html>
