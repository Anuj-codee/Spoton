<%- include('../partials/head') %>
<body class="min-h-screen p-6" style="font-family: 'Inter', sans-serif; background: var(--paper, #F6F4EE); color: var(--ink, #1E2A26);">
<%- include('../partials/nav') %>
<style>
  :root {
    --ink: #1E2A26;
    --paper: #F6F4EE;
    --moss: #2F5D50;
    --moss-dark: #234438;
    --clay: #C1622D;
    --line: #DCD6C6;
  }

  body { font-family: 'Inter', sans-serif; background: var(--paper); color: var(--ink); }
  .display { font-family: 'Fraunces', serif; }
  .field {
    width: 100%; padding: .7rem .95rem; border-radius: .6rem;
    border: 1px solid var(--line); background: #fff;
    font-size: .95rem; transition: border-color .15s, box-shadow .15s;
  }
  .field:focus { outline: none; border-color: var(--moss); box-shadow: 0 0 0 3px rgba(47, 93, 80, .15); }
  .field::placeholder { color: #9C978A; }
  .side-panel {
    background: radial-gradient(120% 120% at 15% 10%, #3C7361 0%, var(--moss) 45%, var(--moss-dark) 100%);
  }
  .grain {
    background-image: radial-gradient(rgba(255,255,255,.08) 1px, transparent 1px);
    background-size: 14px 14px;
  }
</style>

<main class="w-full max-w-4xl bg-white rounded-2xl shadow-xl overflow-hidden grid md:grid-cols-5">

  <aside class="side-panel grain relative hidden md:flex md:col-span-2 flex-col justify-between p-9 text-white">
    <div>
      <span class="inline-block text-[11px] tracking-[.18em] uppercase text-white/70 font-medium mb-8">Host Studio</span>
      <h2 class="display text-[2.1rem] leading-[1.15]">Update your listing.<br>Keep it ready.</h2>
    </div>
    <p class="text-white/75 text-sm leading-relaxed max-w-[22ch]">
      Refresh details, add your latest place story, and make your stay easier to discover.
    </p>
  </aside>

  <section class="md:col-span-3 p-8 sm:p-10">
    <div class="mb-7">
      <div class="w-16 h-16 rounded-2xl border border-[#DCD6C6] bg-[#F6F4EE] flex items-center justify-center text-3xl mx-auto mb-4">🏡</div>
      <h1 class="display text-[1.75rem] text-[#1E2A26] mb-1 text-center">Edit your home</h1>
      <p class="text-sm text-[#6B6558] text-center">Update your property details.</p>
    </div>

    <form action="/host/edit-home/<%=home._id%>" method="POST" class="space-y-5">
      <input value="<%=home._id%>" name="id" type="hidden">

      <div>
        <label for="housename" class="block text-sm font-medium mb-1.5">Property name</label>
        <input id="housename" type="text" value="<%=home.housename%>" name="housename" placeholder="e.g. Cozy Lake Cottage" required class="field">
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="price" class="block text-sm font-medium mb-1.5">Property price</label>
          <input id="price" type="number" name="price" value="<%=home.price%>" placeholder="e.g. 1000000" required class="field">
        </div>

        <div>
          <label for="location" class="block text-sm font-medium mb-1.5">Location</label>
          <input id="location" type="text" name="location" value="<%=home.location || ''%>" placeholder="e.g. Goa, India" required class="field">
        </div>
      </div>

      <div>
        <label for="photo" class="block text-sm font-medium mb-1.5">Photo URL</label>
        <input id="photo" type="url" name="photo" value="<%=home.photo || ''%>" placeholder="https://example.com/home.jpg" required class="field">
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="rating" class="block text-sm font-medium mb-1.5">Rating</label>
          <input id="rating" type="number" name="rating" min="0" max="5" step="0.1" value="<%=home.rating || ''%>" placeholder="e.g. 4.8" required class="field">
        </div>

        <div class="flex items-end">
          <span class="w-full rounded-lg border border-[#DCD6C6] bg-[#F6F4EE] px-4 py-3 text-sm text-[#6B6558]">
            Listing ready to publish
          </span>
        </div>
      </div>

      <div>
        <label for="description" class="block text-sm font-medium mb-1.5">Description</label>
        <textarea id="description" name="description" rows="4" placeholder="Describe the property, rooms, amenities, and guest experience" required class="field resize-y"><%=home.description || ''%></textarea>
      </div>

      <button type="submit" class="w-full bg-[#2F5D50] text-white font-medium py-2.5 rounded-lg hover:bg-[#234438] transition-colors">
        Update Home
      </button>
    </form>

    <p class="text-center text-sm text-[#6B6558] mt-6">
      Want to review it later?
      <a href="/" class="text-[#2F5D50] hover:underline font-medium">View all homes</a>
    </p>
  </section>

</main>

</body>
</html>
