<%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 flex flex-col" style="font-family: 'Inter', sans-serif;">

  <!-- Navbar -->
  <nav class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center gap-3">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-8 h-8 rounded-xl bg-linear-to-br from-rose-500 to-orange-400 flex items-center justify-center text-white font-bold text-sm">S</div>
        <span class="text-xl font-bold text-white tracking-tight group-hover:text-rose-300 transition-colors">StaySpot</span>
      </a>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="flex-1 flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-2xl">

      <!-- Card -->
      <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 shadow-2xl shadow-black/40">

        <!-- Icon + Heading -->
        <div class="text-center mb-8">
          <div class="w-16 h-16 rounded-2xl bg-linear-to-br from-rose-500/20 to-orange-400/10 border border-rose-500/20 flex items-center justify-center text-3xl mx-auto mb-4">🏡</div>
          <h1 class="text-2xl font-extrabold text-white tracking-tight mb-1">List Your Home</h1>
          <p class="text-slate-400 text-sm">Register your property and start earning today.</p>
        </div>

        <!-- Form -->
        <form action="/host/add-home" method="POST" class="space-y-5">
          <div>
            <label for="housename" class="block text-sm font-medium text-slate-300 mb-2">Property Name</label>
            <input
              id="housename"
              type="text"
              name="housename"
              placeholder="e.g. Cozy Lake Cottage"
              required
              class="w-full bg-slate-800 border border-slate-700 text-slate-100 placeholder-slate-500 rounded-xl px-4 py-3 text-sm outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 transition-all duration-200"
            >
          </div>
          <div>
            <label for="price" class="block text-sm font-medium text-slate-300 mb-2">Property price</label>
            <input
              id="price"
              type="number"
              name="price"
              placeholder="e.g. 1000000"
              required
              class="w-full bg-slate-800 border border-slate-700 text-slate-100 placeholder-slate-500 rounded-xl px-4 py-3 text-sm outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 transition-all duration-200"
            >
          </div>
          <div>
            <label for="photoUrl" class="block text-sm font-medium text-slate-300 mb-2">Photo URL</label>
            <input
              id="photoUrl"
              type="url"
              name="photoUrl"
              placeholder="https://example.com/home.jpg"
              required
              class="w-full bg-slate-800 border border-slate-700 text-slate-100 placeholder-slate-500 rounded-xl px-4 py-3 text-sm outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 transition-all duration-200"
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="rating" class="block text-sm font-medium text-slate-300 mb-2">Rating</label>
              <input
                id="rating"
                type="number"
                name="rating"
                min="0"
                max="5"
                step="0.1"
                placeholder="e.g. 4.8"
                required
                class="w-full bg-slate-800 border border-slate-700 text-slate-100 placeholder-slate-500 rounded-xl px-4 py-3 text-sm outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 transition-all duration-200"
              >
            </div>
            <div>
              <label for="location" class="block text-sm font-medium text-slate-300 mb-2">Location</label>
              <input
                id="location"
                type="text"
                name="location"
                placeholder="e.g. Goa, India"
                required
                class="w-full bg-slate-800 border border-slate-700 text-slate-100 placeholder-slate-500 rounded-xl px-4 py-3 text-sm outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 transition-all duration-200"
              >
            </div>
          </div>
          <div>
            <label for="description" class="block text-sm font-medium text-slate-300 mb-2">Description</label>
            <textarea
              id="description"
              name="description"
              rows="4"
              placeholder="Describe the property, rooms, amenities, and guest experience"
              required
              class="w-full bg-slate-800 border border-slate-700 text-slate-100 placeholder-slate-500 rounded-xl px-4 py-3 text-sm outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 transition-all duration-200 resize-y"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-linear-to-r from-rose-500 to-orange-400 hover:from-rose-600 hover:to-orange-500 text-white font-semibold py-3 rounded-xl transition-all duration-200 shadow-lg shadow-rose-900/40 hover:shadow-rose-800/60 hover:-translate-y-0.5 active:translate-y-0"
          >
            Register Home
          </button>
        </form>

        <!-- Back link -->
        <p class="text-center text-slate-500 text-sm mt-6">
          Already listed?
          <a href="/" class="text-rose-400 hover:text-rose-300 font-medium transition-colors">View all homes →</a>
        </p>

      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="text-center text-slate-700 text-xs py-6">
    © 2026 StaySpot. All rights reserved.
  </footer>

</body>
</html>
