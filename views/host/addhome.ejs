<%- include('../partials/head') %>
<body class="min-h-screen bg-[#F6F4EE] text-[#1E2A26]" style="font-family: 'Inter', sans-serif;">
<%- include('../partials/nav') %>

  <main class="min-h-screen px-4 py-6 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl overflow-hidden rounded-4xl border border-[#DCD6C6] bg-white shadow-[0_20px_70px_rgba(30,42,38,0.12)]">
      <div class="grid lg:grid-cols-[0.95fr_1.55fr]">
        
        <!-- Left Panel -->
        <section class="relative overflow-hidden bg-[radial-gradient(120%_120%_at_15%_10%,#3C7361_0%,#2F5D50_45%,#234438_100%)] p-8 text-white sm:p-10 lg:p-12">
          <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(rgba(255,255,255,0.18) 1px, transparent 1px); background-size: 14px 14px;"></div>
          <div class="relative flex h-full flex-col justify-between gap-8">
            <div>
              <span class="mb-6 inline-block rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] text-white/80">List a Home</span>
              <h1 class="font-['Fraunces'] text-3xl leading-tight sm:text-4xl">
                Share your space with travelers.
              </h1>
              <p class="mt-4 max-w-[28ch] text-sm leading-7 text-white/80 sm:text-base">
                Turn your property into a thriving rental business. Complete, showcase, and watch bookings grow.
              </p>
            </div>

            <div class="space-y-4">
              <div class="rounded-2xl border border-white/20 bg-white/10 p-4 backdrop-blur-sm">
                <p class="text-sm font-semibold">✓ Simple setup</p>
                <p class="text-xs text-white/70">Fill in a few details and go live</p>
              </div>
              <div class="rounded-2xl border border-white/20 bg-white/10 p-4 backdrop-blur-sm">
                <p class="text-sm font-semibold">✓ Full control</p>
                <p class="text-xs text-white/70">Manage availability and pricing</p>
              </div>
              <div class="rounded-2xl border border-white/20 bg-white/10 p-4 backdrop-blur-sm">
                <p class="text-sm font-semibold">✓ Get paid</p>
                <p class="text-xs text-white/70">Secure transactions every booking</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Right Panel - Form -->
        <section class="bg-[#FCFBF7] p-6 sm:p-8 lg:p-10">
          <div class="mb-8">
            <h2 class="text-2xl font-semibold text-[#1E2A26] sm:text-3xl">Register your home</h2>
            <p class="mt-2 text-sm text-[#6B6558]">It only takes a few minutes to get started.</p>
          </div>

          <form action="/host/add-home" method="POST" class="space-y-5" enctype="multipart/form-data">
            
            <div>
              <label for="housename" class="block text-sm font-medium text-[#1E2A26] mb-1.5">Property Name</label>
              <input
                id="housename"
                type="text"
                name="housename"
                placeholder="e.g. Cozy Lake Cottage"
                required
                class="w-full rounded-lg border border-[#DCD6C6] bg-white px-4 py-2.5 text-[#1E2A26] placeholder-[#9C978A] text-sm transition focus:border-[#2F5D50] focus:outline-none focus:ring-2 focus:ring-[#2F5D50]/15"
              >
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="price" class="block text-sm font-medium text-[#1E2A26] mb-1.5">Property Price</label>
                <input
                  id="price"
                  type="number"
                  name="price"
                  placeholder="e.g. 1000000"
                  required
                  class="w-full rounded-lg border border-[#DCD6C6] bg-white px-4 py-2.5 text-[#1E2A26] placeholder-[#9C978A] text-sm transition focus:border-[#2F5D50] focus:outline-none focus:ring-2 focus:ring-[#2F5D50]/15"
                >
              </div>
              <div>
                <label for="rating" class="block text-sm font-medium text-[#1E2A26] mb-1.5">Rating</label>
                <input
                  id="rating"
                  type="number"
                  name="rating"
                  min="0"
                  max="5"
                  step="0.1"
                  placeholder="e.g. 4.8"
                  required
                  class="w-full rounded-lg border border-[#DCD6C6] bg-white px-4 py-2.5 text-[#1E2A26] placeholder-[#9C978A] text-sm transition focus:border-[#2F5D50] focus:outline-none focus:ring-2 focus:ring-[#2F5D50]/15"
                >
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="location" class="block text-sm font-medium text-[#1E2A26] mb-1.5">Location</label>
                <input
                  id="location"
                  type="text"
                  name="location"
                  accept="image/jpg,image/png,image/jpeg"
                  placeholder="e.g. Goa, India"
                  required
                  class="w-full rounded-lg border border-[#DCD6C6] bg-white px-4 py-2.5 text-[#1E2A26] placeholder-[#9C978A] text-sm transition focus:border-[#2F5D50] focus:outline-none focus:ring-2 focus:ring-[#2F5D50]/15"
                >
              </div>
              <div>
                <label for="photo" class="block text-sm font-medium text-[#1E2A26] mb-1.5">Photo URL</label>
                <input
                  id="photo"
                  type="file"
                  name="photo"
                  multiple
                  required
                  class="w-full rounded-lg border border-[#DCD6C6] bg-white px-4 py-2.5 text-[#1E2A26] placeholder-[#9C978A] text-sm transition focus:border-[#2F5D50] focus:outline-none focus:ring-2 focus:ring-[#2F5D50]/15"
                >
              </div>
            </div>

            <div>
              <label for="description" class="block text-sm font-medium text-[#1E2A26] mb-1.5">Description</label>
              <textarea
                id="description"
                name="description"
                rows="5"
                placeholder="Describe the property, rooms, amenities, and guest experience"
                required
                class="w-full rounded-lg border border-[#DCD6C6] bg-white px-4 py-2.5 text-[#1E2A26] placeholder-[#9C978A] text-sm transition focus:border-[#2F5D50] focus:outline-none focus:ring-2 focus:ring-[#2F5D50]/15 resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full rounded-lg bg-[#2F5D50] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#234438] focus:outline-none focus:ring-2 focus:ring-[#2F5D50]/30 focus:ring-offset-2 focus:ring-offset-white"
            >
              Register Home
            </button>
          </form>

          <p class="mt-6 text-center text-sm text-[#6B6558]">
            <a href="/" class="font-medium text-[#2F5D50] hover:underline">Back to homes →</a>
          </p>
        </section>

      </div>
    </div>
  </main>

</body>
</html>

