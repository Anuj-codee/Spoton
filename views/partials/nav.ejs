<nav class="border-b border-[#DCD6C6] sticky top-0 z-50 bg-white shadow-sm">

  <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">

    <div class="flex items-center justify-between">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 min-w-fit">

        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#2F5D50] text-lg font-bold text-white">
          S
        </div>

        <div>
          <span class="block text-base font-semibold tracking-tight text-[#1E2A26]">
            StaySpot
          </span>

          <span class="text-xs text-[#9C978A]">
            Rentals
          </span>
        </div>

      </a>


      <!-- Center Navigation -->
      <div class="hidden gap-1 sm:flex">

        <!-- Everyone can browse -->
        <a href="/" class="rounded-lg px-4 py-2.5 text-sm font-medium text-[#1E2A26] transition hover:bg-[#F6F4EE]">
          Browse
        </a>


        <!-- Logged-in users -->
        <% if (isLoggedIn) { %>

          <!-- Guest and Host -->
          <a href="/favourite"
            class="rounded-lg px-4 py-2.5 text-sm font-medium text-[#1E2A26] transition hover:bg-[#F6F4EE]">
            Favourites
          </a>
          <a href="/host/bookings"
            class="rounded-lg px-4 py-2.5 text-sm font-medium text-[#1E2A26] transition hover:bg-[#F6F4EE]">
            Bookings
          </a>
          <!-- Only Host -->
          <% if (userType === 'host') { %>

            <a href="/host/host-home-list"
              class="rounded-lg px-4 py-2.5 text-sm font-medium text-[#1E2A26] transition hover:bg-[#F6F4EE]">
              My Homes
            </a>
            <% } %>

              <% } %>

      </div>


      <!-- Right Navigation -->
      <div class="flex items-center gap-2">


        <!-- Logged-in User -->
        <% if (isLoggedIn) { %>


          <!-- Add Home only visible to Host -->
          <% if (userType === 'host') { %>

            <a href="/host/add-home"
              class="rounded-lg bg-[#2F5D50] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#234438]">
              Add Home
            </a>

            <% } %>


              <!-- Logout visible to every logged-in user -->
              <form action="/logout" method="POST" class="inline">

                <button type="submit"
                  class="rounded-lg bg-[#F6F4EE] px-5 py-2.5 text-sm font-semibold text-[#1E2A26] transition hover:bg-[#DCD6C6]">
                  Logout
                </button>

              </form>


              <!-- Not logged in -->
              <% } else { %>


                <a href="/login"
                  class="rounded-lg bg-[#F6F4EE] px-5 py-2.5 text-sm font-semibold text-[#1E2A26] transition hover:bg-[#DCD6C6]">
                  Login
                </a>


                <a href="/signup"
                  class="rounded-lg bg-[#2F5D50] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#234438]">
                  Signup
                </a>


                <% } %>

      </div>

    </div>

  </div>

</nav>
