
<footer class="bg-[#F8F9F6] border-t border-[#D9DFDB] mt-16">
  <div class="max-w-6xl mx-auto px-6 py-14">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">

      <!-- Brand -->
      <div class="md:col-span-4">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-9 h-9 rounded-lg bg-[#2F5D50] text-white flex items-center justify-center font-display font-semibold shadow-sm">
            S
          </div>
          <div>
            <p class="font-semibold text-[#1E2A26] leading-tight">StaySpot</p>
            <p class="text-xs text-[#6B746B] leading-tight">Rentals</p>
          </div>
        </div>
        <p class="text-sm text-[#66736C] leading-relaxed max-w-[32ch]">
          Discover homes that feel like a fresh start — browse, compare, and book with confidence.
        </p>

        <div class="flex items-center gap-3 mt-6">
          <a href="#" aria-label="Instagram"
             class="w-9 h-9 rounded-full border border-[#D9DFDB] flex items-center justify-center text-[#6B746B] hover:text-[#2F5D50] hover:border-[#2F5D50] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="w-4 h-4">
              <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href="#" aria-label="Twitter / X"
             class="w-9 h-9 rounded-full border border-[#D9DFDB] flex items-center justify-center text-[#6B746B] hover:text-[#2F5D50] hover:border-[#2F5D50] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="w-4 h-4">
              <path d="M4 4l16 16M20 4L4 20"/>
            </svg>
          </a>
          <a href="#" aria-label="Facebook"
             class="w-9 h-9 rounded-full border border-[#D9DFDB] flex items-center justify-center text-[#6B746B] hover:text-[#2F5D50] hover:border-[#2F5D50] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="w-4 h-4">
              <path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h3l1-3h-4v-2c0-.6.4-1 1-1z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Explore -->
      <div class="md:col-span-2">
        <p class="text-xs font-semibold tracking-[.12em] uppercase text-[#66736C] mb-4">Explore</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/browse" class="text-[#485A4F] hover:text-[#2F5D50] transition-colors">Browse</a></li>
          <li><a href="/favourites" class="text-[#485A4F] hover:text-[#2F5D50] transition-colors">Favourites</a></li>
          <li><a href="/host/homes" class="text-[#485A4F] hover:text-[#2F5D50] transition-colors">My Homes</a></li>
          <li><a href="/host/bookings" class="text-[#485A4F] hover:text-[#2F5D50] transition-colors">Bookings</a></li>
        </ul>
      </div>

      <!-- Hosting -->
      <div class="md:col-span-2">
        <p class="text-xs font-semibold tracking-[.12em] uppercase text-[#66736C] mb-4">Hosting</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/host/add-home" class="text-[#485A4F] hover:text-[#2F5D50] transition-colors">Add a home</a></li>
          <li><a href="/host/bookings" class="text-[#485A4F] hover:text-[#2F5D50] transition-colors">Manage bookings</a></li>
          <li><a href="#" class="text-[#485A4F] hover:text-[#2F5D50] transition-colors">Hosting guide</a></li>
        </ul>
      </div>

      <!-- Support -->
      <div class="md:col-span-2">
        <p class="text-xs font-semibold tracking-[.12em] uppercase text-[#66736C] mb-4">Support</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#" class="text-[#485A4F] hover:text-[#2F5D50] transition-colors">Help centre</a></li>
          <li><a href="#" class="text-[#485A4F] hover:text-[#2F5D50] transition-colors">Contact us</a></li>
          <li><a href="#" class="text-[#485A4F] hover:text-[#2F5D50] transition-colors">Safety</a></li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="md:col-span-2">
        <p class="text-xs font-semibold tracking-[.12em] uppercase text-[#66736C] mb-4">Stay updated</p>
        <form action="/newsletter" method="POST" class="space-y-2">
          <input
            type="email"
            name="email"
            placeholder="Your email"
            class="w-full px-3 py-2 text-sm rounded-lg border border-[#D9DFDB] bg-[#EEF3EF] focus:bg-white focus:border-[#2F5D50] focus:ring-4 focus:ring-[#2F5D50]/10 outline-none transition"
          />
          <button
            type="submit"
            class="w-full text-sm font-medium py-2 rounded-lg bg-[#2F5D50] text-white hover:bg-[#234438] transition-colors"
          >
            Subscribe
          </button>
        </form>
      </div>

    </div>

    <div class="mt-12 pt-6 border-t border-[#D9DFDB] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#66736C]">
      <p>&copy; <%= new Date().getFullYear() %> StaySpot Rentals. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <a href="#" class="hover:text-[#2F5D50] transition-colors">Privacy</a>
        <a href="#" class="hover:text-[#2F5D50] transition-colors">Terms</a>
        <a href="#" class="hover:text-[#2F5D50] transition-colors">Sitemap</a>
      </div>
    </div>

  </div>
</footer>
